FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/agents
COPY . .

RUN pip install --no-cache-dir \
    "mcp>=1.0.0" \
    "fastapi" \
    "uvicorn" \
    "httpx>=0.27.0,<0.29" \
    "pydantic>=2.9.0,<3.0" \
    "pydantic-ai-slim[openai,anthropic,google,mcp,cli]>=1.0.0,<2.0" \
    "pydantic-settings>=2.5.0,<3.0" \
    "pyyaml>=6.0,<7.0" \
    "beautifulsoup4>=4.12,<5.0" \
    "duckduckgo-search>=5.0.0,<7.0" \
    "yfinance>=0.2.0,<0.6" \
    "tenacity>=8.0.0,<9.0" \
    "nats-py>=2.9.0" \
    "asyncpg>=0.31.0" \
    "logfire" \
    "google-generativeai" \
    "openai" \
    "anthropic" \
    "certifi"

ENV PYTHONPATH=/opt/agents/src
ENV LOGFIRE_SEND_TO_LOGFIRE=false

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "orchestration.pipeline_executor_service:app", "--host", "0.0.0.0", "--port", "8080"]
