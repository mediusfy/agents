{
  "openapi": "3.1.0",
  "info": {
    "title": "Rufkis SRE Platform — Domain 4: Local-First SRE Workspace",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {

      // ============================================================
      // 4.1 Workspace
      // ============================================================
      "Workspace": {
        "description": "A collaborative workspace for an SRE team. Root entity for local-first sync, holding configuration, members, and offline state.",
        "type": "object",
        "required": ["id", "name", "slug", "created_at", "created_by"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "Display name (e.g., 'SRE Platform Team')"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
            "maxLength": 63,
            "description": "URL-friendly unique identifier"
          },
          "description": {
            "type": "string",
            "maxLength": 1024,
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "settings": {
            "$ref": "#/components/schemas/WorkspaceSettings"
          },
          "replication_version": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Monotonic version number for CRDT/P2P sync conflict resolution"
          },
          "created_by": { "type": "string", "format": "uuid" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },

      "WorkspaceSettings": {
        "description": "Workspace-level configuration settings.",
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "default": "UTC",
            "description": "IANA timezone (e.g., 'America/New_York')"
          },
          "incident_auto_triage_enabled": {
            "type": "boolean",
            "default": true
          },
          "self_healing_enabled": {
            "type": "boolean",
            "default": false,
            "description": "Allows agents to auto-remediate without human approval"
          },
          "finops_enabled": {
            "type": "boolean",
            "default": true
          },
          "default_escalation_policy_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "gitops_repo_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Default Git repository for runbook storage"
          },
          "offline_sync_enabled": {
            "type": "boolean",
            "default": true
          },
          "sync_interval_seconds": {
            "type": "integer",
            "minimum": 10,
            "default": 30
          },
          "retention_days": {
            "type": "integer",
            "minimum": 7,
            "default": 90,
            "description": "Data retention period in days"
          }
        }
      },

      // ============================================================
      // 4.2 Team & TeamMembership
      // ============================================================
      "Team": {
        "description": "A team within a workspace, grouping users for ownership, escalation, and showback allocation.",
        "type": "object",
        "required": ["id", "workspace_id", "name", "slug", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK → Workspace.id"
          },
          "name": { "type": "string", "maxLength": 255 },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
            "maxLength": 63
          },
          "description": { "type": "string", "nullable": true, "maxLength": 1024 },
          "on_call_schedule_id": {
            "type": "string",
            "nullable": true,
            "description": "External schedule reference (e.g., PagerDuty schedule ID)"
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },

      "TeamMembership": {
        "description": "Associates a user with a team and defines their role within the workspace.",
        "type": "object",
        "required": ["id", "team_id", "user_id", "role", "joined_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "team_id": { "type": "string", "format": "uuid", "description": "FK → Team.id" },
          "user_id": { "type": "string", "format": "uuid", "description": "FK → User.id" },
          "role": {
            "type": "string",
            "enum": [
              "Owner",
              "Admin",
              "Editor",
              "Viewer",
              "OnCallPrimary",
              "OnCallSecondary",
              "Observer"
            ]
          },
          "is_active": {
            "type": "boolean",
            "default": true
          },
          "joined_at": { "type": "string", "format": "date-time" },
          "left_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },

      // ============================================================
      // 4.3 CRDT / Offline Data Structures
      // ============================================================
      "CRDTItem": {
        "description": "Base structure for any CRDT-synchronized item in the local-first workspace. Every mutable entity extends this pattern.",
        "type": "object",
        "required": ["id", "type", "version", "lamport_timestamp", "actor_id", "data"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Globally unique ID (remains same across offline/online)"
          },
          "type": {
            "type": "string",
            "description": "Document type (e.g., 'incident', 'runbook', 'note', 'comment')"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Monotonic version for this document (MVCC)"
          },
          "lamport_timestamp": {
            "type": "integer",
            "description": "Lamport logical clock value for conflict resolution"
          },
          "actor_id": {
            "type": "string",
            "description": "Last writer ID (user or device UUID)"
          },
          "data": {
            "type": "object",
            "description": "The actual document content (free-form JSON, schema-validated at the application layer)"
          },
          "tombstone": {
            "type": "boolean",
            "default": false,
            "description": "If true, the item has been deleted (soft delete for sync)"
          },
          "parent_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Parent document ID for hierarchical content (e.g., comment → incident)"
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },

      "CRDTMergeOperation": {
        "description": "A single CRDT merge operation that is exchanged during P2P sync. Follows an LWW-Register (Last-Writer-Wins) strategy per field.",
        "type": "object",
        "required": ["item_id", "field", "value", "lamport_timestamp", "actor_id"],
        "properties": {
          "item_id": { "type": "string", "format": "uuid" },
          "field": {
            "type": "string",
            "description": "Field path being updated (dot-notation, e.g., 'data.title')"
          },
          "value": {
            "description": "The new value for the field"
          },
          "lamport_timestamp": {
            "type": "integer",
            "description": "Lamport clock value for this operation"
          },
          "actor_id": { "type": "string", "format": "uuid" },
          "operation": {
            "type": "string",
            "enum": ["Upsert", "Delete", "MergeArrayAdd", "MergeArrayRemove", "CounterIncrement"],
            "default": "Upsert"
          }
        }
      },

      // ============================================================
      // 4.4 P2PSyncPayload
      // ============================================================
      "P2PSyncPayload": {
        "description": "Payload exchanged between peers during P2P synchronization. Contains a batch of CRDT operations.",
        "type": "object",
        "required": ["sync_id", "sender_id", "sender_version", "operations", "sent_at"],
        "properties": {
          "sync_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique sync session identifier (deduplication key)"
          },
          "sender_id": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the sending peer (device or workspace instance)"
          },
          "sender_version": {
            "type": "integer",
            "description": "Sender's current workspace replication version"
          },
          "operations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CRDTMergeOperation" },
            "description": "Batch of CRDT operations to merge"
          },
          "batch_size": {
            "type": "integer",
            "description": "Number of operations in this payload"
          },
          "checksum": {
            "type": "string",
            "nullable": true,
            "description": "SHA-256 checksum of the operations array for integrity verification"
          },
          "compression": {
            "type": "string",
            "enum": ["none", "gzip", "zstd"],
            "default": "none"
          },
          "sent_at": { "type": "string", "format": "date-time" },
          "received_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },

      // ============================================================
      // 4.5 WorkspaceStateSnapshot
      // ============================================================
      "WorkspaceStateSnapshot": {
        "description": "A full or incremental snapshot of a workspace's state. Used for offline bootstrap, restore, and checkpointing.",
        "type": "object",
        "required": ["id", "workspace_id", "snapshot_type", "version", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workspace_id": { "type": "string", "format": "uuid" },
          "snapshot_type": {
            "type": "string",
            "enum": ["Full", "Incremental", "Delta"],
            "description": "Full = complete state; Incremental = changes since last full; Delta = changes since last snapshot"
          },
          "version": {
            "type": "integer",
            "description": "Workspace replication version at snapshot time"
          },
          "base_version": {
            "type": "integer",
            "nullable": true,
            "description": "For Incremental/Delta snapshots, the version this is based on"
          },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CRDTItem" },
            "description": "Serialized documents in the snapshot"
          },
          "item_count": {
            "type": "integer",
            "description": "Number of items in this snapshot"
          },
          "size_bytes": {
            "type": "integer",
            "description": "Serialized size in bytes"
          },
          "checksum": {
            "type": "string",
            "description": "SHA-256 checksum of the items payload"
          },
          "compression": {
            "type": "string",
            "enum": ["none", "gzip", "zstd"],
            "default": "zstd"
          },
          "created_by_device_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Device that created the snapshot"
          },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Auto-expiry for temporary snapshots"
          }
        }
      },

      // ============================================================
      // 4.6 Device (P2P endpoint)
      // ============================================================
      "Device": {
        "description": "Represents a user's device or workspace instance participating in P2P synchronization.",
        "type": "object",
        "required": ["id", "user_id", "name", "device_type", "last_seen_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK → User.id (owner of this device)"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "Human-readable device name (e.g., 'John's MacBook Pro')"
          },
          "device_type": {
            "type": "string",
            "enum": ["Desktop", "Laptop", "Mobile", "Server", "CLI", "WebBrowser", "Other"]
          },
          "public_key": {
            "type": "string",
            "nullable": true,
            "description": "Ed25519 public key for P2P message signing"
          },
          "last_seen_at": { "type": "string", "format": "date-time" },
          "last_ip": {
            "type": "string",
            "format": "ipv4",
            "nullable": true
          },
          "is_active": {
            "type": "boolean",
            "default": true
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },

      // ============================================================
      // 4.7 User
      // ============================================================
      "User": {
        "description": "A platform user. Used across all domains for ownership, approval, and audit attribution.",
        "type": "object",
        "required": ["id", "email", "display_name", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "display_name": {
            "type": "string",
            "maxLength": 255
          },
          "avatar_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": ["Admin", "Engineer", "Viewer", "Agent"],
            "default": "Engineer"
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "last_seen_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      }

    }
  }
}
