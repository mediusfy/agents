{
  "openapi": "3.1.0",
  "info": {
    "title": "Rufkis SRE Platform — Domain 2: Automated FinOps ROI",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {

      // ============================================================
      // 2.1 CostAnomaly
      // ============================================================
      "CostAnomaly": {
        "description": "A detected cost anomaly, indicating unexpected or anomalous cloud spending in a specific region, service, or dimension.",
        "type": "object",
        "required": [
          "id", "anomaly_type", "severity", "region", "provider",
          "detected_amount_cents", "baseline_amount_cents",
          "variance_percent", "detected_at", "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "anomaly_type": {
            "type": "string",
            "enum": [
              "Spike",
              "Drop",
              "SustainedIncrease",
              "NewServiceUsage",
              "UnexpectedRegion",
              "OrphanedResource",
              "ReservedInstanceWaste"
            ],
            "description": "Classification of the anomaly pattern"
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low", "Info"],
            "description": "Business impact severity"
          },
          "provider": {
            "type": "string",
            "enum": ["aws", "gcp", "azure", "kubernetes", "other"]
          },
          "region": {
            "type": "string",
            "description": "Cloud region where anomaly was detected (e.g., 'us-east-1')"
          },
          "service": {
            "type": "string",
            "nullable": true,
            "description": "Specific cloud service (e.g., 'EC2', 'CloudSQL', 'BigQuery')"
          },
          "account_id": {
            "type": "string",
            "nullable": true,
            "description": "Cloud account / billing account ID"
          },
          "team_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "FK → Team.id for showback attribution"
          },
          "detected_amount_cents": {
            "type": "integer",
            "description": "Observed cost in cents (USD) over the window"
          },
          "baseline_amount_cents": {
            "type": "integer",
            "description": "Expected cost in cents (USD) based on historical baseline"
          },
          "variance_percent": {
            "type": "number",
            "format": "float",
            "description": "Percentage variance from baseline (can be negative for savings)"
          },
          "window_start": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the analysis time window"
          },
          "window_end": {
            "type": "string",
            "format": "date-time",
            "description": "End of the analysis time window"
          },
          "dimensions": {
            "type": "object",
            "nullable": true,
            "description": "Additional breakdown dimensions (e.g., {'instance_type': 't3.large', 'usage_type': 'BoxUsage'})"
          },
          "root_cause_hint": {
            "type": "string",
            "nullable": true,
            "maxLength": 500,
            "description": "AI-generated root cause suggestion"
          },
          "status": {
            "type": "string",
            "enum": ["Open", "Acknowledged", "Investigating", "Resolved", "FalsePositive", "Dismissed"]
          },
          "assigned_to": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "User or agent ID assigned for resolution"
          },
          "detected_at": {
            "type": "string",
            "format": "date-time"
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "optimization_recommendation_ids": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "description": "FKs → OptimizationRecommendation.id"
          }
        }
      },

      // ============================================================
      // 2.2 OptimizationRecommendation
      // ============================================================
      "OptimizationRecommendation": {
        "description": "A cost-savings recommendation with projected ROI, risk level, and implementation details.",
        "type": "object",
        "required": [
          "id", "title", "recommendation_type", "provider", "region",
          "estimated_monthly_savings_cents", "implementation_cost_cents",
          "confidence_score", "roi_months", "status", "created_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "Short title (e.g., 'Downsize m5.xlarge to m5.large in prod-us-east-1')"
          },
          "description": {
            "type": "string",
            "maxLength": 4096,
            "nullable": true,
            "description": "Detailed explanation of the recommendation"
          },
          "recommendation_type": {
            "type": "string",
            "enum": [
              "ResizeInstance",
              "DeleteOrphanedResource",
              "PurchaseReservedInstance",
              "CommitmentDiscount",
              "ChangeStorageTier",
              "EliminateUnusedLoadBalancer",
              "OptimizeDataTransfer",
              "RightSizeCluster",
              "EnableAutoScaling",
              "ScheduleShutdown",
              "ChangePricingTier",
              "MigrateToSpot",
              "Other"
            ]
          },
          "provider": { "type": "string", "enum": ["aws", "gcp", "azure", "kubernetes", "other"] },
          "region": { "type": "string", "description": "Cloud region" },
          "resource_id": {
            "type": "string",
            "nullable": true,
            "description": "Cloud resource identifier (e.g., 'i-0abcd1234')"
          },
          "service": {
            "type": "string",
            "nullable": true,
            "description": "Cloud service name"
          },

          // --- Financial Fields ---
          "current_monthly_cost_cents": {
            "type": "integer",
            "description": "Current monthly cost in cents"
          },
          "estimated_monthly_savings_cents": {
            "type": "integer",
            "description": "Projected monthly savings in cents"
          },
          "estimated_monthly_cost_after_cents": {
            "type": "integer",
            "nullable": true,
            "description": "Projected monthly cost after implementation"
          },
          "implementation_cost_cents": {
            "type": "integer",
            "default": 0,
            "description": "One-time cost to implement (engineering hours, migration costs) in cents"
          },
          "implementation_effort_hours": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "description": "Estimated engineering hours to implement"
          },
          "roi_months": {
            "type": "number",
            "format": "float",
            "description": "Months to break even (implementation_cost / monthly_savings)"
          },
          "first_year_savings_cents": {
            "type": "integer",
            "nullable": true,
            "description": "Projected savings over 12 months (USD cents)"
          },

          // --- Risk & Confidence ---
          "confidence_score": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 1,
            "description": "AI confidence score (0.0 = low, 1.0 = high)"
          },
          "risk_level": {
            "type": "string",
            "enum": ["Low", "Medium", "High"],
            "default": "Medium",
            "description": "Operational risk if recommendation is applied"
          },
          "risk_description": {
            "type": "string",
            "nullable": true,
            "maxLength": 1024
          },

          // --- Lifecycle ---
          "status": {
            "type": "string",
            "enum": [
              "PendingReview",
              "Approved",
              "Scheduled",
              "InProgress",
              "Implemented",
              "Rejected",
              "Expired",
              "RolledBack"
            ]
          },
          "ticket_url": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "description": "Link to Jira/GitHub issue tracking implementation"
          },
          "implemented_by_remediation_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "FK → RemediationRequest.id if executed via GitOps"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Categorization tags (e.g., ['compute', 'savings-plan'])"
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "implemented_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },

      // ============================================================
      // 2.3 ShowbackAllocation
      // ============================================================
      "ShowbackAllocation": {
        "description": "Chargeback/showback allocation of cloud costs to teams or services for a given billing period.",
        "type": "object",
        "required": [
          "id", "team_id", "service_id", "billing_period",
          "total_cost_cents", "allocated_cost_cents",
          "allocation_method", "created_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "team_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK → Team.id"
          },
          "team_name": {
            "type": "string",
            "maxLength": 255,
            "description": "Denormalized team name for quick queries"
          },
          "service_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "FK → Service.id (null if aggregated at team level)"
          },
          "service_name": {
            "type": "string",
            "maxLength": 255,
            "nullable": true
          },
          "billing_period": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "description": "Billing period in YYYY-MM format (e.g., '2026-06')"
          },
          "provider": {
            "type": "string",
            "enum": ["aws", "gcp", "azure", "kubernetes", "all"]
          },
          "total_cost_cents": {
            "type": "integer",
            "description": "Total raw cloud cost attributed to this scope (USD cents)"
          },
          "allocated_cost_cents": {
            "type": "integer",
            "description": "Cost after showback adjustments, discounts, credits (USD cents)"
          },
          "unallocated_cost_cents": {
            "type": "integer",
            "description": "Cost that could not be attributed (USD cents)",
            "default": 0
          },
          "allocation_method": {
            "type": "string",
            "enum": [
              "DirectTag",
              "ResourceLabel",
              "ProportionalUsage",
              "FixedPercentage",
              "Headcount",
              "ManualOverride"
            ],
            "description": "Method used to allocate costs"
          },
          "cost_breakdown": {
            "type": "object",
            "nullable": true,
            "description": "Detailed cost breakdown by sub-dimensions",
            "properties": {
              "compute_cents": { "type": "integer" },
              "storage_cents": { "type": "integer" },
              "networking_cents": { "type": "integer" },
              "data_transfer_cents": { "type": "integer" },
              "managed_services_cents": { "type": "integer" },
              "other_cents": { "type": "integer" }
            }
          },
          "usage_metrics": {
            "type": "object",
            "nullable": true,
            "description": "Usage-based metrics (e.g., {'cpu_hours': 1234.5, 'storage_gb_months': 500})"
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },

      // ============================================================
      // 2.4 CostVsReliabilityScore
      // ============================================================
      "CostVsReliabilityScore": {
        "description": "A trade-off score comparing cost optimization against reliability/SLO risk for a service or deployment pattern.",
        "type": "object",
        "required": [
          "id", "service_id", "environment", "score_date",
          "cost_efficiency_score", "reliability_score", "trade_off_ratio"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "service_id": {
            "type": "string",
            "format": "uuid",
            "description": "FK → Service.id"
          },
          "service_name": {
            "type": "string",
            "maxLength": 255,
            "description": "Denormalized for performance"
          },
          "environment": {
            "$ref": "../domain1_gitops_remediation.json#/components/schemas/EnvironmentRef"
          },
          "score_date": {
            "type": "string",
            "format": "date",
            "description": "Date the score was computed (daily snapshots)"
          },

          // --- Scores (0-100) ---
          "cost_efficiency_score": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 100,
            "description": "0 = expensive, 100 = optimally cost-efficient"
          },
          "reliability_score": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 100,
            "description": "0 = fragile, 100 = highly reliable"
          },
          "trade_off_ratio": {
            "type": "number",
            "format": "float",
            "description": "cost_efficiency / reliability (values > 1 = cost-efficient but risky; < 1 = reliable but expensive)"
          },

          // --- Component breakdown ---
          "cost_dimensions": {
            "type": "object",
            "nullable": true,
            "properties": {
              "provisioning_efficiency": { "type": "number", "format": "float" },
              "reserved_instance_coverage": { "type": "number", "format": "float" },
              "waste_percentage": { "type": "number", "format": "float" },
              "commitment_discount_usage": { "type": "number", "format": "float" }
            }
          },
          "reliability_dimensions": {
            "type": "object",
            "nullable": true,
            "properties": {
              "slo_attainment": { "type": "number", "format": "float" },
              "redundancy_score": { "type": "number", "format": "float" },
              "mtbf_hours": { "type": "number", "format": "float" },
              "recovery_time_score": { "type": "number", "format": "float" }
            }
          },

          // --- Recommendations ---
          "suggested_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": { "type": "string" },
                "expected_impact": {
                  "type": "string",
                  "enum": ["CostImprovement", "ReliabilityImprovement", "Neutral"]
                },
                "delta_cost_efficiency": { "type": "number", "format": "float" },
                "delta_reliability": { "type": "number", "format": "float" }
              }
            }
          },

          "created_at": { "type": "string", "format": "date-time" }
        }
      },

      // ============================================================
      // 2.5 FinOpsDashboard (summary aggregate)
      // ============================================================
      "FinOpsDashboardSummary": {
        "description": "Aggregated FinOps overview for a workspace (not persisted, computed on the fly or cached in Redis).",
        "type": "object",
        "required": ["period", "total_spend_cents", "total_savings_cents", "anomaly_count"],
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "total_spend_cents": { "type": "integer" },
          "total_savings_cents": { "type": "integer" },
          "savings_percentage": { "type": "number", "format": "float" },
          "anomaly_count": { "type": "integer" },
          "open_anomalies": { "type": "integer" },
          "pending_recommendations": { "type": "integer" },
          "top_recommendations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/OptimizationRecommendation" },
            "maxItems": 5
          },
          "team_allocations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "team_id": { "type": "string", "format": "uuid" },
                "team_name": { "type": "string" },
                "allocated_cents": { "type": "integer" },
                "budget_cents": { "type": "integer", "nullable": true }
              }
            }
          }
        }
      }

    }
  }
}
