# .env.example
# Add your API keys here
# Provider API Keys (If calling providers directly, otherwise handled by LiteLLM)
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# ---------------------------------------------------------------------------
# LiteLLM AI Gateway (Proxy) Settings
# ---------------------------------------------------------------------------
# To switch between local Docker and Cloud Run, uncomment the appropriate block:

# LOCAL DOCKER (Default for local development)
LITELLM_BASE_URL="http://0.0.0.0:4000"
# Use these if your specific agent tools rely on native SDKs directly:
# OPENAI_BASE_URL="http://0.0.0.0:4000/v1"
# ANTHROPIC_BASE_URL="http://0.0.0.0:4000"

# CLOUD RUN (Default for GKS/Kubernetes environments)
# LITELLM_BASE_URL="https://litellm-proxy-xxxxxx.run.app"
# OPENAI_BASE_URL="https://litellm-proxy-xxxxxx.run.app/v1"
# ANTHROPIC_BASE_URL="https://litellm-proxy-xxxxxx.run.app"

# Virtual Key for authenticating against the LiteLLM Proxy
LITELLM_VIRTUAL_KEY="sk-litellm-master-key-replace-me"


# Logfire project: https://logfire-eu.pydantic.dev/drew/argus
# All pydantic_ai agent runs are auto-instrumented when this is set.
# Generate a token at https://logfire-eu.pydantic.dev/drew/argus/settings
LOGFIRE_API_KEY="pylf_v2_eu_..."
