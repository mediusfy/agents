# ── OpenClaw Agent Ecosystem ──────────────────────────────────────────────
# Copy to .env and fill in your keys. At least one API key is required.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your keys

# ── LLM Provider API Keys (at least one required) ────────────────────────

# OpenAI (used by BA, Frontend, Test, Database, DevOps, Docs agents)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic (used by Backend, Review, Security, CTO, UX agents)
# Get your key at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (used by SRE agent)
# Get your key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...

# ── Agent Model Overrides (optional) ──────────────────────────────────────
# Each agent defaults to a specific model. Override individual agents here.

# BA_MODEL=gpt-4o-mini
# BACKEND_MODEL=claude-sonnet-4-20250514
# FRONTEND_MODEL=gpt-4o
# TEST_MODEL=gpt-4o-mini
# SRE_MODEL=gemini-2.0-flash
# REVIEW_MODEL=claude-sonnet-4-20250514
# DATABASE_MODEL=gpt-4o-mini
# DEVOPS_MODEL=gpt-4o-mini
# DOCS_MODEL=gpt-4o-mini
# SECURITY_MODEL=claude-sonnet-4-20250514
# UX_MODEL=claude-sonnet-4-20250514
# CTO_MODEL=claude-sonnet-4-20250514

# Travel & Finance Agents
# HOLIDAY_PLANNER_MODEL=gpt-4o
# REGION_ANALYZER_MODEL=gpt-4o
# ASYMMETRIC_REVIEWER_MODEL=gpt-4o
# CURRENT_EVENTS_MODEL=gpt-4o
# WEATHER_MODEL=gpt-4o-mini
# ACCOUNTANT_MODEL=gpt-4o
# PRICE_ANALYST_MODEL=gemini-2.0-pro
# MARKET_SHARK_MODEL=gemini-2.0-pro
# CRYPTO_ORACLE_MODEL=gemini-2.0-pro

# ── Pipeline Configuration (optional) ─────────────────────────────────────

# Output directory for generated artifacts
# OUTPUT_DIR=./generated-app

# Max retry attempts for the full pipeline (default: 2)
# MAX_RETRIES=2

# Max concurrent LLM calls (prevents rate limit issues, default: 5)
# MAX_CONCURRENT_LLM_CALLS=5

# Checkpoint directory for resume support
# CHECKPOINT_DIR=./.claw-checkpoints

# Vector database persistence directory
# VECTOR_DB_DIR=./.claw-vectordb
