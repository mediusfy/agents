# syntax=docker/dockerfile:1.7
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    git \
    openssh-client \
    ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p -m 0700 /root/.ssh \
    && ssh-keyscan github.com >> /root/.ssh/known_hosts

WORKDIR /opt/agents

COPY . .

# pydantic-agents is a private GitHub repo pinned via git+ssh in pyproject.toml.
# Auth is either a PAT mounted as the `pydantic_agents_pat` BuildKit secret (CI)
# or a forwarded ssh agent (docker build --ssh default, local).
# The `vector` extra (pgvector, sentence-transformers) is required for the
# agents' ADR/architecture context retrieval.
RUN --mount=type=ssh --mount=type=secret,id=pydantic_agents_pat,required=false \
    if [ -s /run/secrets/pydantic_agents_pat ]; then \
      git config --global url."https://x-access-token:$(cat /run/secrets/pydantic_agents_pat)@github.com/mediusfy/pydantic_agents.git".insteadOf "ssh://git@github.com/mediusfy/pydantic_agents.git"; \
    fi && \
    pip install --no-cache-dir -e ".[dev,vector]" && \
    pip install --no-cache-dir uvicorn; \
    rc=$?; rm -f /root/.gitconfig; exit $rc

EXPOSE 8080

ENV DAGSTER_HOME=/opt/agents/.dagmem
ENV LOGFIRE_SEND_TO_LOGFIRE=false

CMD ["uvicorn", "orchestration.mcp_server:mcp.sse_app", "--host", "0.0.0.0", "--port", "8080"]
